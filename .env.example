# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Server only: reads/writes eBay tokens, which the browser never sees.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# eBay developer app (developer.ebay.com -> Application Keys). Production keys by default.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName (eBay Redirect URL name) whose "accept URL" is https://<your-domain>/api/ebay/callback
EBAY_RU_NAME=
# Set to "sandbox" to use eBay's sandbox while testing.
EBAY_ENV=production
# Marketplace account deletion notifications (required by eBay for production keys)
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=https://<your-domain>/api/ebay/account-deletion
